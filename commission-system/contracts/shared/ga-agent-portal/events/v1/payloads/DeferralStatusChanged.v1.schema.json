{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ga.example/portal/contracts/events/v1/payloads/DeferralStatusChanged.v1.schema.json",
  "title": "DeferralStatusChanged payload (v1)",
  "description": "도래 배치·해약 이벤트(설계서 §4.2). → deferral_item 상태 갱신. 모르는 필드는 허용한다(설계서 §4.5 — 소비자는 무시).",
  "type": "object",
  "required": [
    "scheduleId",
    "from",
    "to",
    "reason"
  ],
  "properties": {
    "scheduleId": {
      "$ref": "../defs.schema.json#/$defs/id"
    },
    "from": {
      "enum": [
        "SCHEDULED",
        "RELEASED",
        "HELD",
        "CANCELLED"
      ]
    },
    "to": {
      "enum": [
        "RELEASED",
        "HELD",
        "CANCELLED"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  }
}
