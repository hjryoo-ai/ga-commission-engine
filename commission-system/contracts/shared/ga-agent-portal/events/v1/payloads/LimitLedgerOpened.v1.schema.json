{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ga.example/portal/contracts/events/v1/payloads/LimitLedgerOpened.v1.schema.json",
  "title": "LimitLedgerOpened payload (v1)",
  "description": "한도 원장 개설(설계서 §4.2). → policy_limit insert. 모르는 필드는 허용한다(설계서 §4.5 — 소비자는 무시).",
  "type": "object",
  "required": [
