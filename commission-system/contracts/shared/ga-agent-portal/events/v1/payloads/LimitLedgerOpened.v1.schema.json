      "$ref": "../defs.schema.json#/$defs/id"
    },
    "policyNo": {
      "$ref": "../defs.schema.json#/$defs/id"
    },
    "agentId": {
      "$ref": "../defs.schema.json#/$defs/agentId"
    },
    "contractDate": {
      "$ref": "../defs.schema.json#/$defs/date"
    },
    "fyStart": {
      "$ref": "../defs.schema.json#/$defs/date"
    },
    "fyEnd": {
      "$ref": "../defs.schema.json#/$defs/date"
    },
    "monthlyPremium": {
      "$ref": "../defs.schema.json#/$defs/nonNegativeWon"
    },
    "limitMultiple": {
      "$ref": "../defs.schema.json#/$defs/decimalString"
    },
    "limitAmount": {
      "$ref": "../defs.schema.json#/$defs/nonNegativeWon"
    },
    "ruleVersionId": {
      "$ref": "../defs.schema.json#/$defs/id"
    }
  }
